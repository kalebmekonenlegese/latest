{
  "name": "hatsey-kaleb-hotel-website",
  "version": "1.0.0",
  "description": "Luxury hotel website for Hatsey Kaleb Hotel",
  "private": true,
 "engines": {
  "node": "22.x"
},
  "scripts": {
    "dev": "vite",
    "start": "npm run dev",
    "server": "node server.js",
    "build": "vite build",
    "preview": "vite preview --port 5000",
    "optimize": "node build-scripts/optimize.js",
    "test": "playwright test",
    "test:backend": "jest --runInBand",
    "email:test": "node scripts/test-email.js",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:debug": "playwright test --debug",
    "lint": "eslint src/main.js vite.config.mjs build-scripts/verify-build.js --ext .js",
    "format": "prettier --write src/main.js vite.config.mjs build-scripts/verify-build.js scripts/seo-gate.js scripts/lighthouse-gate.js --ignore-path .gitignore",
    "format:check": "prettier --check src/main.js vite.config.mjs build-scripts/verify-build.js scripts/seo-gate.js scripts/lighthouse-gate.js --ignore-path .gitignore",
    "build:verify": "node build-scripts/verify-build.js",
    "security:audit": "node tests/security-hardening.spec.js && npm audit --audit-level=high --production",
    "seo:check": "node scripts/seo-gate.js",
    "lighthouse:check": "node scripts/lighthouse-gate.js",
    "ci": "npm run lint && npm run format:check && npm run build && npm run build:verify && npm run security:audit && npm run seo:check && npm run test:backend && npx playwright test tests/focused.test.js --workers=1"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "@sentry/node": "^10.70.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^16.1.4",
    "express": "^4.18.4",
    "express-rate-limit": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.5",
    "stripe": "^22.4.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.44.0",
    "axe-core": "^4.8.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "lighthouse": "^13.4.1",
    "prettier": "^2.0.0",
    "prisma": "^5.18.0",
    "sharp": "^0.35.3",
    "supertest": "^7.2.2",
    "terser": "^5.49.0",
    "vite": "^8.1.5"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
