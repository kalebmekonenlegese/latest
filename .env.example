# Hatsey Kaleb Hotel - Backend Environment Configuration
# Copy this file to .env and update values for your environment

# ============================================================
# SERVER CONFIGURATION
# ============================================================
NODE_ENV=development
PORT=3000
HOST=localhost

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================
FRONTEND_URL=http://localhost:5173
VITE_API_URL=
PRODUCTION_DOMAIN=hatseykalebhotel.com
CDN_URL=https://cdn.hatseykalebhotel.com

# ============================================================
# JWT AUTHENTICATION
# ============================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# PostgreSQL (recommended for production)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hatsey_kaleb_hotel
DB_USER=postgres
DB_PASSWORD=your-db-password
DATABASE_URL=postgresql://postgres:your-db-password@localhost:5432/hatsey_kaleb_hotel?schema=public

# ============================================================
# EMAIL CONFIGURATION
# ============================================================
# SendGrid
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=info@hatseykalebhotel.com

# Alternative: Mailgun
MAILGUN_API_KEY=key-xxxxx
MAILGUN_DOMAIN=mail.hatseykalebhotel.com

# Alternative: AWS SES
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=AKIA...
AWS_SES_SECRET_ACCESS_KEY=...

# ============================================================
# PAYMENT PROCESSING
# ============================================================
# Stripe
STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ============================================================
# ANALYTICS
# ============================================================
VITE_GA_MEASUREMENT_ID=G-XXXXX
VITE_GTM_ID=GTM-XXXXX
VITE_CLARITY_PROJECT_ID=CLARITY_PROJECT_ID
GOOGLE_ANALYTICS_ID=G-XXXXX
MIXPANEL_TOKEN=xxxxx
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
VITE_CDN_URL=https://cdn.hatseykalebhotel.com
VITE_PRODUCTION_DOMAIN=hatseykalebhotel.com
VITE_DEPLOYMENT_ENV=production

# ============================================================
# DEPLOYMENT
# ============================================================
PRODUCTION_SSH_HOST=
PRODUCTION_SSH_USER=
PRODUCTION_SSH_PORT=22
PRODUCTION_DEPLOY_PATH=/var/www/hatsey-kaleb-hotel
PRODUCTION_SERVICE_NAME=hatsey-kaleb-app
BACKUP_SCHEDULE=@daily
ROLLBACK_INSTRUCTIONS=Use git revert or restore from backup in /backups

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=debug
LOG_FORMAT=json

# ============================================================
# SECURITY
# ============================================================
# Development: http://localhost:5173
# Production: https://matrix-neon-five.vercel.app
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
COOKIE_SECRET=your-cookie-secret

# HTTPS / TLS
HTTPS_KEY_PATH=./certs/server.key
HTTPS_CERT_PATH=./certs/server.crt
ENABLE_HTTPS_REDIRECT=false

# CSRF
CSRF_COOKIE_NAME=csrfToken
CSRF_TOKEN_HEADER=X-CSRF-Token

# ============================================================
# MONITORING & ALERTS
# ============================================================
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=hatsey-kaleb-hotel@1.0.0
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxxx
BACKUP_DIRECTORY=./backups

# ============================================================
# API KEYS
# ============================================================
# External services
GEOLOCATION_API_KEY=xxxxx
CURRENCY_CONVERSION_API_KEY=xxxxx
