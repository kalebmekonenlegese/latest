# Hatsey Kaleb Hotel - Environment Template
# Copy this file to .env and replace placeholders with your real local or deployment values.
# This file is safe to commit because it contains no secrets.

# ============================================================
# Application
# ============================================================
# Required for startup and runtime mode.
NODE_ENV=development
PORT=3000
APP_NAME="Hatsey Kaleb Hotel"
APP_URL="http://localhost:3000"

# ============================================================
# Frontend / API
# ============================================================
# Required for backend CORS and frontend API access.
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
VITE_API_URL="http://localhost:3000"

# ============================================================
# Database (Prisma / PostgreSQL)
# ============================================================
# Required. Use your local Postgres or your Supabase project URL.
DATABASE_URL="postgresql://postgres:4143@localhost:5432/hatsey_kaleb_hotel?schema=public"
DIRECT_URL="postgresql://postgres:4143@localhost:5432/hatsey_kaleb_hotel?schema=public"

# ============================================================
# Authentication / Security
# ============================================================
# Required for JWT and cookie auth.
JWT_SECRET="replace-with-a-long-random-dev-secret"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="replace-with-a-long-random-cookie-secret"
SESSION_SECRET="replace-with-a-long-random-session-secret"
CSRF_SECRET="replace-with-a-long-random-csrf-secret"

# Optional / usually defaults are fine.
CSRF_COOKIE_NAME="csrfToken"
CSRF_TOKEN_HEADER="X-CSRF-Token"
ENABLE_HTTPS_REDIRECT=false
HTTPS_KEY_PATH="./certs/server.key"
HTTPS_CERT_PATH="./certs/server.crt"
TRUST_PROXY=true
HELMET_ENABLED=true
BCRYPT_SALT_ROUNDS=12

# ============================================================
# Email (SMTP)
# ============================================================
# Optional unless you want real booking/contact emails to send.
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="noreply@localhost"
HOTEL_NOTIFICATION_EMAIL="reservations@example.com"
HOTEL_EMAIL="reservations@example.com"

# ============================================================
# Stripe
# ============================================================
# Stripe checkout and webhook processing require the corresponding secret values.
STRIPE_SECRET_KEY="sk_test_your_secret_key_here"
# Copy the whsec_ value printed by `stripe listen --forward-to ...` for local development.
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
STRIPE_CURRENCY="usd"
VITE_STRIPE_PUBLIC_KEY="pk_test_your_public_key_here"

# ============================================================
# Supabase
# ============================================================
# Optional for custom Supabase integrations.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ============================================================
# Analytics / Frontend Runtime
# ============================================================
# Optional, used only when analytics are enabled.
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
VITE_GTM_ID="GTM-XXXXXXX"
VITE_CLARITY_PROJECT_ID="your-clarity-project-id"
VITE_GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"
VITE_GOOGLE_SITE_VERIFICATION=""
VITE_BING_SITE_VERIFICATION=""
VITE_DEPLOYMENT_ENV="development"

# ============================================================
# Logging / Monitoring
# ============================================================
# Optional but recommended in production.
LOG_LEVEL="debug"
LOG_FILE="./logs/app.log"
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE="hatsey-kaleb-hotel@local"

# ============================================================
# Rate Limiting / Security
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# File Uploads
# ============================================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH="./uploads"

# ============================================================
# Optional Services
# ============================================================
REDIS_URL="redis://localhost:6379"
CACHE_TTL=300

# ============================================================
# Deployment / Test Helpers
# ============================================================
BASE_URL="http://localhost:3000"
TEST_BASE_URL="http://localhost:3000"
PLAYWRIGHT_BASE_URL="http://localhost:3000"
SKIP_SERVER_START=false

# ============================================================
# Notes
# ============================================================
# 1. Required keys for server startup: DATABASE_URL, JWT_SECRET, COOKIE_SECRET, FRONTEND_URL.
# 2. Local frontend URL is usually http://localhost:5173 with the backend on http://localhost:3000.
# 3. Stripe and SMTP can remain blank if you only want local testing without external integrations.
# 4. Keep your real .env file private and do not commit it to GitHub.
